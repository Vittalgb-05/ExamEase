# ExamEase Environment Configuration
# Copy these into your hosting dashboard (e.g. Render > Environment) or local .env file.
# Never commit actual secret keys or production passwords to version control.

DEBUG=False
SECRET_KEY=your-secure-random-secret-key-goes-here
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
ALLOWED_HOSTS=localhost,127.0.0.1,examease.onrender.com
CSRF_TRUSTED_ORIGINS=https://examease.onrender.com
TIME_ZONE=UTC
